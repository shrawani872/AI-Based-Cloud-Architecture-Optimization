generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AwsMetric {
  id          String   @id @default(uuid())
  instanceId  String
  service     String
  region      String
  metricName  String
  metricValue Float
  unit        String   @default("Count")
  timestamp   DateTime @default(now())
  metadata    Json?

  @@index([instanceId, metricName])
  @@index([timestamp])
}

model Anomaly {
  id          String   @id @default(uuid())
  resourceId  String
  anomalyType String
  severity    String   @default("MEDIUM")
  score       Float
  status      String   @default("OPEN")
  detectedAt  DateTime @default(now())
  details     Json?

  @@index([resourceId])
  @@index([status])
}

model Forecast {
  id           String   @id @default(uuid())
  resourceId   String
  targetMetric String
  forecastValue Float
  confidenceMin Float?
  confidenceMax Float?
  forecastDate DateTime
  createdAt    DateTime @default(now())

  @@index([resourceId, targetMetric])
}

model Recommendation {
  id               String   @id @default(uuid())
  resourceId       String
  serviceName      String
  recommendationType String
  title            String
  description      String
  currentCost      Float
  projectedCost    Float
  potentialSavings Float
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([resourceId])
  @@index([status])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("INFO")
  message   String
  context   Json?
  timestamp DateTime @default(now())
}
